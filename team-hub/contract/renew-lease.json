{
  "interface": "issues.renew-lease",
  "description": "Extend the running lease by one lease duration.",
  "method": "POST",
  "path": "/api/v1/teams/:teamId/issues/:issueId/renew-lease",
  "auth": "Host",
  "request": {
    "headers": {
      "Authorization": "Bearer th_host_<64 hex characters>",
      "Content-Type": "application/json",
      "X-Team-Hub-Protocol-Version": "1.0.0"
    },
    "body": {
      "lease_token": "1f0c6c2e-5b5a-4f3e-9d47-6a1b2c3d4e5f"
    }
  },
  "response": {
    "status": 200,
    "body": {
      "lease_expires_at": 1700000080000
    }
  },
  "notes": [
    "A lapsed lease answers 412 LEASE_EXPIRED and the card returns to waiting_host."
  ]
}
